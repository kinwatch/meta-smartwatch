#!/bin/sh
# lte-data-up: bring the modem ONLINE so connman can manage cellular data.
#
# Division of labour (established on-device 2026-06-23):
#  - connman's ofono plugin owns the cellular *data* path: once the modem is
#    online + registered it creates a "cellular" service (favorite, autoconnect),
#    activates the context, and configures IPv4 (correct /28 -> gateway on-link,
#    no onlink hack) + IPv6 + DNS + default route, with proper WiFi/cellular
#    arbitration and UI visibility. We must NOT hand-configure the interface or it
#    fights connman.
#  - But connman does NOT online the modem (the cellular service only exists while
#    the modem is online+registered, so connman can't bootstrap it). ofono leaves
#    the modem Powered-but-offline at boot. So this helper's only job is to online
#    the modem (with a toggle to force acquisition at marginal indoor signal);
#    connman takes it from there.

OB="gdbus call --system -d org.ofono"
MODEM=/ril_0
log() { echo "lte-data-up: $*"; }

systemctl is-active ofono >/dev/null 2>&1 || systemctl start ofono
for _ in $(seq 1 30); do
    $OB -o $MODEM -m org.ofono.Modem.GetProperties >/dev/null 2>&1 && break
    sleep 2
done

log "onlining modem"
$OB -o $MODEM -m org.ofono.Modem.SetProperty Online "<true>" >/dev/null 2>&1

# Wait for registration; if it doesn't acquire, toggle off->on (a fresh-booted or
# stuck-searching modem often needs this), then leave it online for connman.
registered=
for i in $(seq 1 20); do
    case "$($OB -o $MODEM -m org.ofono.NetworkRegistration.GetProperties 2>/dev/null)" in
        *"'Status': <'registered'>"*) registered=1; break ;;
    esac
    if [ "$i" = 10 ]; then
        log "not registered yet -> toggling radio to force acquisition"
        $OB -o $MODEM -m org.ofono.Modem.SetProperty Online "<false>" >/dev/null 2>&1
        sleep 4
        $OB -o $MODEM -m org.ofono.Modem.SetProperty Online "<true>" >/dev/null 2>&1
    fi
    sleep 3
done
[ -n "$registered" ] && log "registered; connman will autoconnect cellular" \
                      || log "still searching; modem left online for connman to connect when it registers"
