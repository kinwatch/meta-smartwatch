[Unit]
Description=Online the LTE modem so connman can manage cellular data (aurora)
After=aurora-lxc-android.service ofono.service connman.service
Wants=ofono.service
ConditionPathExists=/dev/binder

[Service]
Type=oneshot
ExecStart=/usr/bin/lte-data-up
RemainAfterExit=yes

[Install]
WantedBy=basic.target
