 src/qml/misc/OneShotSound.qml              | 43 ++++++++++++++++++++++
 src/qml/notifications/NotificationView.qml |  3 +-
 src/qml/quickpanel/QuickPanel.qml          |  3 +-
 4 files changed, 47 insertions(+), 4 deletions(-)
 create mode 100644 src/qml/misc/OneShotSound.qml

